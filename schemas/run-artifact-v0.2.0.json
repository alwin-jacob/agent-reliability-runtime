{
  "$defs": {
    "Accounting": {
      "additionalProperties": false,
      "description": "Counts logical operations separately from retry attempts.\n\nA logical model turn is one runtime request for a model decision, excluding\nretries. A model attempt is each provider try. A logical tool call is one\nrequested tool operation, while a tool attempt is each execution try.",
      "properties": {
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "external_model_calls": {
          "title": "External Model Calls",
          "type": "boolean"
        },
        "failed_model_attempts": {
          "minimum": 0,
          "title": "Failed Model Attempts",
          "type": "integer"
        },
        "failed_tool_attempts": {
          "minimum": 0,
          "title": "Failed Tool Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "logical_model_turns": {
          "minimum": 0,
          "title": "Logical Model Turns",
          "type": "integer"
        },
        "logical_tool_calls": {
          "minimum": 0,
          "title": "Logical Tool Calls",
          "type": "integer"
        },
        "model_attempts": {
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "successful_model_attempts": {
          "minimum": 0,
          "title": "Successful Model Attempts",
          "type": "integer"
        },
        "successful_tool_attempts": {
          "minimum": 0,
          "title": "Successful Tool Attempts",
          "type": "integer"
        },
        "tool_attempts": {
          "minimum": 0,
          "title": "Tool Attempts",
          "type": "integer"
        }
      },
      "required": [
        "logical_model_turns",
        "model_attempts",
        "successful_model_attempts",
        "failed_model_attempts",
        "logical_tool_calls",
        "tool_attempts",
        "successful_tool_attempts",
        "failed_tool_attempts",
        "cost_usd",
        "external_model_calls"
      ],
      "title": "Accounting",
      "type": "object"
    },
